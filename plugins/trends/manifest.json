{
  "id": "trends",
  "name": "开源趋势",
  "icon": "trending-up",
  "version": "0.11.0",
  "entry": "index.cjs",
  "settings": {
    "shortcut": {
      "type": "string",
      "format": "accelerator",
      "label": "打开插件快捷键",
      "default": ""
    },
    "archiveEnabled": {
      "type": "boolean",
      "label": "每天自动保存公开趋势文档",
      "default": true
    },
    "archiveTime": {
      "type": "time",
      "label": "每日趋势归档时间",
      "default": "10:00"
    },
    "defaultPeriod": {
      "type": "select",
      "label": "GitHub Trending 默认时间范围",
      "default": "daily",
      "options": [
        "daily",
        "weekly",
        "monthly"
      ]
    },
    "defaultLanguage": {
      "type": "string",
      "label": "默认语言筛选（空表示全部）",
      "default": ""
    },
    "cacheMinutes": {
      "type": "number",
      "label": "趋势缓存分钟数",
      "default": 20,
      "min": 5,
      "max": 120
    }
  },
  "locales": {
    "zh-CN": "locales/zh-CN.json",
    "en-US": "locales/en-US.json"
  }
}
